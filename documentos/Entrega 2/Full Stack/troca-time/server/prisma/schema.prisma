generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model custo_evento {
  id            Int      @id @default(autoincrement())
  evento_id     Int
  descricao     String   @db.VarChar(200)
  tipo          String   @db.VarChar(20)
  valor         Decimal  @db.Decimal(12, 2)
  criado_em     DateTime @default(now()) @db.DateTime(0)
  atualizado_em DateTime @default(now()) @db.DateTime(0)
  evento        evento   @relation(fields: [evento_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_custo_evento")

  @@index([evento_id], map: "fk_custo_evento")
}

model endereco {
  id            Int      @id @default(autoincrement())
  nome_local    String   @db.VarChar(200)
  cep           String   @db.Char(8)
  rua           String   @db.VarChar(200)
  numero        String?  @db.VarChar(20)
  complemento   String?  @db.VarChar(200)
  bairro        String   @db.VarChar(120)
  cidade        String   @db.VarChar(120)
  estado        String   @db.Char(2)
  criado_em     DateTime @default(now()) @db.DateTime(0)
  atualizado_em DateTime @default(now()) @db.DateTime(0)
  evento        evento[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model evento {
  id                 Int            @id @default(autoincrement())
  nome               String         @db.VarChar(200)
  descricao          String?        @db.Text
  inicio             DateTime       @db.DateTime(0)
  fim                DateTime       @db.DateTime(0)
  prazo_cotacao      DateTime?      @db.Date
  endereco_id        Int
  organizador_id     Int
  publico_min        Int
  publico_max        Int
  margem_lucro       Decimal        @db.Decimal(5, 2)
  custo_total        Decimal?       @db.Decimal(12, 2)
  ticket_publico_min Decimal?       @db.Decimal(10, 2)
  ticket_publico_max Decimal?       @db.Decimal(10, 2)
  status             String         @default("rascunho") @db.VarChar(20)
  criado_em          DateTime       @default(now()) @db.DateTime(0)
  atualizado_em      DateTime       @default(now()) @db.DateTime(0)
  custo_evento       custo_evento[]
  endereco           endereco       @relation(fields: [endereco_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_evento_endereco")
  usuario            usuario        @relation(fields: [organizador_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_evento_organizador")
  vaga_servico       vaga_servico[]

  @@index([endereco_id], map: "fk_evento_endereco")
  @@index([organizador_id], map: "fk_evento_organizador")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model mensagem {
  id           Int      @id @default(autoincrement())
  proposta_id  Int
  remetente_id Int?
  tipo         String   @default("texto") @db.VarChar(20)
  conteudo     String   @db.Text
  criado_em    DateTime @default(now()) @db.DateTime(0)
  proposta     proposta @relation(fields: [proposta_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mensagem_proposta")
  usuario      usuario? @relation(fields: [remetente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mensagem_remetente")

  @@index([proposta_id], map: "fk_mensagem_proposta")
  @@index([remetente_id], map: "fk_mensagem_remetente")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model proposta {
  id                 Int          @id @default(autoincrement())
  vaga_servico_id    Int
  fornecedor_id      Int
  origem             String       @db.VarChar(20)
  valor              Decimal      @db.Decimal(12, 2)
  descricao          String       @db.Text
  observacoes        String?      @db.Text
  validade           DateTime     @db.Date
  status             String       @default("enviada") @db.VarChar(20)
  conversa_criada_em DateTime?    @db.DateTime(0)
  criado_em          DateTime     @default(now()) @db.DateTime(0)
  atualizado_em      DateTime     @default(now()) @db.DateTime(0)
  mensagem           mensagem[]
  usuario            usuario      @relation(fields: [fornecedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_proposta_fornecedor")
  vaga_servico       vaga_servico @relation(fields: [vaga_servico_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_proposta_vaga")

  @@unique([vaga_servico_id, fornecedor_id], map: "uq_proposta_vaga_fornecedor")
  @@index([fornecedor_id], map: "fk_proposta_fornecedor")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuario {
  id              Int        @id @default(autoincrement())
  nome            String     @db.VarChar(200)
  email           String     @unique(map: "email") @db.VarChar(320)
  telefone        String?    @db.VarChar(20)
  cpf             String?    @unique(map: "cpf") @db.Char(11)
  cnpj            String?    @unique(map: "cnpj") @db.Char(14)
  senha_hash      String     @db.VarChar(255)
  tipo_usuario    String     @db.VarChar(20)
  categoria       String?    @db.VarChar(20)
  descricao       String?    @db.Text
  status_cadastro String     @default("pendente") @db.VarChar(20)
  avaliado_por    Int?
  avaliado_em     DateTime?  @db.DateTime(0)
  criado_em       DateTime   @default(now()) @db.DateTime(0)
  atualizado_em   DateTime   @default(now()) @db.DateTime(0)
  evento          evento[]
  mensagem        mensagem[]
  proposta        proposta[]
  usuario         usuario?   @relation("usuarioTousuario", fields: [avaliado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_avaliador")
  other_usuario   usuario[]  @relation("usuarioTousuario")

  @@index([avaliado_por], map: "fk_usuario_avaliador")
}

model vaga_servico {
  id            Int        @id @default(autoincrement())
  evento_id     Int
  nome          String     @db.VarChar(200)
  categoria     String     @db.VarChar(20)
  descricao     String?    @db.Text
  criado_em     DateTime   @default(now()) @db.DateTime(0)
  atualizado_em DateTime   @default(now()) @db.DateTime(0)
  proposta      proposta[]
  evento        evento     @relation(fields: [evento_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vaga_evento")

  @@index([evento_id], map: "fk_vaga_evento")
}

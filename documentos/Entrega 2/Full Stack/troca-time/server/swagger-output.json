{
  "openapi": "3.0.0",
  "info": {
    "title": "API Troca Ticket",
    "description": "Documentação das rotas da API do Troca Ticket",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "tags": [
    {
      "name": "Fornecedores",
      "description": "Dados dos fornecedores"
    },
    {
      "name": "Administração",
      "description": "Painel do administrador"
    },
    {
      "name": "Eventos",
      "description": "Eventos cadastrados"
    }
  ],
  "paths": {
    "/eventos/": {
      "get": {
        "tags": [
          "Eventos"
        ],
        "summary": "Lista os eventos",
        "description": "Lista todos os eventos, do mais antigo para o mais recente, com o organizador e a quantidade de propostas recebidas.",
        "responses": {
          "200": {
            "description": "Lista de eventos",
            "content": {
              "application/json": {
                "example": {
                  "eventos": [
                    {
                      "id": 1,
                      "nome": "Festival Som de Primavera",
                      "status": "publicado",
                      "descricao": "Festival de música independente com bandas locais e praça de alimentação.",
                      "inicio": "2026-11-21 14:00:00",
                      "fim": "2026-11-21 23:00:00",
                      "nome_local": "Parque das Artes",
                      "quantidade_propostas": 3,
                      "ticket_estimado_min": 45,
                      "ticket_estimado_max": 80,
                      "nome_organizador": "Mariana Costa",
                      "organizador_id": 2
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "example": {
                  "status": 500,
                  "erro": "Erro interno do servidor"
                }
              }
            }
          }
        }
      }
    },
    "/admin/resumo": {
      "get": {
        "tags": [
          "Administração"
        ],
        "summary": "Busca os totais da plataforma",
        "description": "Cadastros pendentes, eventos em cotação e propostas com status enviada.",
        "responses": {
          "200": {
            "description": "Resumo da plataforma",
            "content": {
              "application/json": {
                "example": {
                  "total_cadastros_pendentes": 2,
                  "total_eventos_cotacao": 0,
                  "total_propostas_recebidas": 3
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "example": {
                  "status": 500,
                  "erro": "Erro interno do servidor"
                }
              }
            }
          }
        }
      }
    },
    "/admin/usuarios": {
      "get": {
        "tags": [
          "Administração"
        ],
        "summary": "Lista os usuários",
        "description": "Lista organizadores e fornecedores. Administradores não aparecem.",
        "responses": {
          "200": {
            "description": "Lista de usuários",
            "content": {
              "application/json": {
                "example": {
                  "usuarios": [
                    {
                      "id": 2,
                      "nome": "Mariana Costa",
                      "status_cadastro": "aprovado",
                      "tipo_usuario": "organizador",
                      "cpf": "12345678901",
                      "cnpj": null,
                      "descricao": "Organizadora de eventos culturais e musicais.",
                      "criado_em": "2026-10-28 20:42:39"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "example": {
                  "status": 500,
                  "erro": "Erro interno do servidor"
                }
              }
            }
          }
        }
      }
    },
    "/fornecedores/{id}": {
      "get": {
        "tags": [
          "Fornecedores"
        ],
        "summary": "Busca os detalhes de um fornecedor e suas propostas",
        "description": "Retorna os dados do fornecedor e as propostas que ele enviou, da mais recente para a mais antiga. Só encontra usuários com tipo_usuario = fornecedor.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 5
            },
            "description": "ID do usuário fornecedor (inteiro positivo)"
          }
        ],
        "responses": {
          "200": {
            "description": "Fornecedor encontrado",
            "content": {
              "application/json": {
                "example": {
                  "id": 5,
                  "nome": "Som & Luz Produções",
                  "status_cadastro": "aprovado",
                  "tipo_usuario": "fornecedor",
                  "categoria": "audiovisual",
                  "cnpj": "23456789000188",
                  "telefone": "11990000005",
                  "email": "contato@someluz.test",
                  "descricao": "Equipamentos de áudio, iluminação e equipe técnica.",
                  "criado_em": "2026-10-28 20:42:39",
                  "propostas": [
                    {
                      "id": 1,
                      "nome_vaga": "Sonorização e iluminação",
                      "categoria": "audiovisual",
                      "evento_id": 1,
                      "nome_evento": "Festival Som de Primavera",
                      "valor": 8500,
                      "status": "enviada",
                      "descricao": "Pacote de sonorização e iluminação com operação técnica."
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "example": {
                  "status": 400,
                  "erro": "ID do fornecedor inválido"
                }
              }
            }
          },
          "404": {
            "description": "Fornecedor não encontrado",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "erro": "Fornecedor não encontrado"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "example": {
                  "status": 500,
                  "erro": "Erro interno do servidor"
                }
              }
            }
          }
        }
      }
    }
  }
}